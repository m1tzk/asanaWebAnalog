<%- include('partials/header') %>

<% if (needAuthWarning) { %>
  <div class="alert alert-warning">
    ⚠️ <strong>Ограничение:</strong> Добавление задач доступно только Team Lead. Нажмите «Войти как Team Lead» в шапке сайта.
  </div>
<% } %>

<div class="header-row">
  <div>
    <h2>Канбан-доска задач</h2>
    <p style="color: var(--muted); font-size: 0.9rem;">Всего задач в PostgreSQL: <%= tasks.length %></p>
  </div>
  <a href="/add<%= currentUser.isAuthenticated ? '?auth=1' : '' %>" class="btn">+ Новая задача</a>
</div>

<div class="chips">
  <a href="/<%= currentUser.isAuthenticated ? '?auth=1' : '' %>" class="chip <%= selectedStatus === 'all' ? 'active' : '' %>">Все</a>
  <a href="/?status=backlog<%= currentUser.isAuthenticated ? '&auth=1' : '' %>" class="chip <%= selectedStatus === 'backlog' ? 'active' : '' %>">Бэклог</a>
  <a href="/?status=in_progress<%= currentUser.isAuthenticated ? '&auth=1' : '' %>" class="chip <%= selectedStatus === 'in_progress' ? 'active' : '' %>">В работе</a>
  <a href="/?status=done<%= currentUser.isAuthenticated ? '&auth=1' : '' %>" class="chip <%= selectedStatus === 'done' ? 'active' : '' %>">Завершенные</a>
</div>

<% if (tasks.length === 0) { %>
  <div style="text-align: center; padding: 40px; background: white; border-radius: 8px;">
    <h3>Задач с данным статусом не обнаружено</h3>
    <p style="color: var(--muted); margin-top: 8px;">Выберите другой статус или создайте новую задачу.</p>
  </div>
<% } else { %>
  <div class="grid">
    <% tasks.forEach(task => { %>
      <div class="card">
        <div class="card-header">
          <span class="badge badge-<%= task.status %>"><%= task.status %></span>
          <span class="card-priority"><%= task.priority %> priority</span>
        </div>

        <h3 class="card-title">
          <a href="/item/<%= task.id %><%= currentUser.isAuthenticated ? '?auth=1' : '' %>" title="<%= task.title %>">
            <%= task.title %>
          </a>
        </h3>

        <p class="card-desc" title="<%= task.description %>">
          <%= task.description || 'Описание отсутствует.' %>
        </p>

        <div class="card-footer">
          <span class="card-assignee" title="<%= task.assignee %>">👤 <%= task.assignee %></span>
          <span class="card-hours">⏱ <%= task.estimatedHours %> ч.</span>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>