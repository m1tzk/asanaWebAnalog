<%- include('partials/header') %>

<div style="max-width: 650px; margin: 0 auto;">
  <a href="/<%= currentUser.isAuthenticated ? '?auth=1' : '' %>" class="btn btn-outline" style="margin-bottom: 20px;">&larr; Назад к доске</a>

  <div class="form-box" style="overflow-wrap: anywhere; word-break: break-word;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
      <span class="badge badge-<%= task.status %>"><%= task.status %></span>
      <span style="font-size: 0.85rem; font-weight: 600; color: #4f46e5;"><%= task.priority %> priority</span>
    </div>

    <!-- Заголовок задачи с переносом длинных слов -->
    <h1 style="font-size: 1.5rem; margin-bottom: 15px; overflow-wrap: anywhere;"><%= task.title %></h1>

    <div style="background: #f8fafc; padding: 15px; border-radius: 6px; margin-bottom: 20px; border-left: 4px solid var(--primary);">
      <h4 style="color: var(--muted); margin-bottom: 5px;">Техническое описание:</h4>
      <p style="white-space: pre-wrap; overflow-wrap: anywhere;"><%= task.description || 'Описание не предоставлено.' %></p>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; border-top: 1px solid var(--border); padding-top: 15px;">
      <div>
        <strong style="color: var(--muted); font-size: 0.85rem;">ОТВЕТСТВЕННЫЙ:</strong>
        <p style="margin-top: 4px; font-weight: 600; overflow-wrap: anywhere;">👤 <%= task.assignee %></p>
      </div>
      <div>
        <strong style="color: var(--muted); font-size: 0.85rem;">ОЦЕНКА ВРЕМЕНИ:</strong>
        <p style="margin-top: 4px; font-weight: 600;">⏱ <%= task.estimatedHours %> ч.</p>
      </div>
      <div>
        <strong style="color: var(--muted); font-size: 0.85rem;">СОЗДАНА:</strong>
        <p style="margin-top: 4px;"><%= new Date(task.createdAt).toLocaleDateString('ru-RU') %></p>
      </div>
      <div>
        <strong style="color: var(--muted); font-size: 0.85rem;">ID ЗАДАЧИ:</strong>
        <p style="margin-top: 4px;">#<%= task.id %></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>