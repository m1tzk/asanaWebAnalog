<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Asana Manager</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="navbar">
    <div class="container nav-flex">
      <a href="/<%= currentUser.isAuthenticated ? '?auth=1' : '' %>" class="brand">📌 AsanaTask</a>
      <nav class="nav-menu">
        <a href="/<%= currentUser.isAuthenticated ? '?auth=1' : '' %>">Задачи</a>
        <a href="/add<%= currentUser.isAuthenticated ? '?auth=1' : '' %>">+ Создать задачу</a>
        
        <% if (currentUser.isAuthenticated) { %>
          <span class="user-tag">👤 <%= currentUser.name %> (<%= currentUser.role %>)</span>
          <a href="/" class="btn btn-outline" style="padding: 4px 10px; font-size: 0.8rem;">Выйти</a>
        <% } else { %>
          <span class="user-tag" style="background: #f1f5f9; color: #64748b;">👤 Гость</span>
          <a href="/?auth=1" class="btn" style="padding: 4px 10px; font-size: 0.8rem;">Войти как Team Lead</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main-area">
    <div class="container">