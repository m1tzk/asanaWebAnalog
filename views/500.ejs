<%- include('partials/header') %>

<div style="text-align: center; padding: 60px 20px;">
  <h1 style="font-size: 4.5rem; color: var(--danger); margin-bottom: 10px;">500</h1>
  <h2>Внутренняя ошибка сервера</h2>
  <p style="color: var(--muted); margin: 15px 0 25px;">Информация о сбое автоматически записана в файл <code>logs/server.log</code>.</p>
  <div style="max-width: 600px; margin: 0 auto 25px; background: #fee2e2; color: #991b1b; padding: 12px; border-radius: 6px; font-family: monospace; font-size: 0.85rem; text-align: left;">
    <%= errorMessage %>
  </div>
  <a href="/<%= currentUser.isAuthenticated ? '?auth=1' : '' %>" class="btn">Вернуться на главную</a>
</div>

<%- include('partials/footer') %>