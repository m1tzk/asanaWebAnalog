<%- include('partials/header') %>

<div style="text-align: center; padding: 60px 20px;">
  <h1 style="font-size: 5rem; color: var(--danger); margin-bottom: 10px;">500</h1>
  <h2>Внутренняя ошибка сервера</h2>
  <p style="color: var(--text-muted); margin: 15px 0 25px;">Произошел сбой при обработке вашего запроса.</p>
  
  <div style="max-width: 600px; margin: 0 auto 25px; background: #fee2e2; color: #991b1b; padding: 15px; border-radius: 6px; text-align: left; font-family: monospace; font-size: 0.9rem;">
    <strong>Информация об ошибке:</strong><br>
    <%= errorMessage %>
  </div>

  <a href="/<%= currentUser.isAuthenticated ? '?auth=1' : '' %>" class="btn">Вернуться на безопасную страницу</a>
</div>

<%- include('partials/footer') %>