###

### 
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "lead1@asana.team",
  "password": "strongPassword123!"
}

###

### 
@authToken = {{login.response.body.token}}

### 
GET {{baseUrl}}/auth/profile

###

###
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{authToken}}

###

### 
POST {{baseUrl}}/api/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "title": "Настроить шифрование персональных данных",
  "description": "Внедрить bcrypt и JWT аутентификацию в бэкенд",
  "priority": "urgent",
  "status": "in_progress",
  "estimatedHours": 10
}

###

### 
