# ============================================================================
# ЭТАП 1 (Builder): Сборка React-приложения в статические файлы
# ============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Копируем package.json и package-lock.json и устанавливаем все зависимости
COPY package*.json ./
RUN npm ci

# Копируем исходный код React-приложения и собираем production-бандл в /app/dist
COPY . .
RUN npm run build

# ============================================================================
# ЭТАП 2 (Production): Раздача собранной статики через Nginx
# ============================================================================
FROM nginx:alpine

# Копируем только готовые файлы сборки из первого этапа
COPY --from=builder /app/dist /usr/share/nginx/html

# Открываем стандартный порт HTTP
EXPOSE 80

# Запускаем Nginx на переднем плане (чтобы контейнер не завершал работу)
CMD ["nginx", "-g", "daemon off;"]